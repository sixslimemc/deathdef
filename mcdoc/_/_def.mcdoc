
use super::super::def::EquipmentSlot
use super::super::def::DeathItemEntry

struct VariableRegister {
    [string]: any
}
dispatch minecraft:storage[deathdef:_] to struct {
    /// top level
    t: VariableRegister,
    /// impl
    v: VariableRegister,
    /// util
    u: VariableRegister,
    /// in-scope temp
    x: VariableRegister,
    // data
    data: struct PrivateData {
        
    },
    // constants
    const: struct Constants {
        equipment_slots: [EquipmentSlot]
    }
}
dispatch minecraft:storage[deathdef:_/in] to struct {
    [any]: any
}
dispatch minecraft:storage[deathdef:_/out] to struct {
    [any]: any
}

dispatch mcdoc:custom_data["_deathdef"] to struct CustomData {
    vanish?: struct {
        item_entry?: DeathItemEntry,
        flag?: true,
    }
}